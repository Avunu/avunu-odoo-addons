<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edi_import_router_document_view_form" model="ir.ui.view">
        <field name="name">edi.import.router.document.form</field>
        <field name="model">edi.import.router.document</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_dispatch" type="object" string="Dispatch" class="btn-primary"
                            invisible="state not in ('review', 'error')"/>
                    <button name="action_reclassify" type="object" string="Re-classify"
                            invisible="state in ('pending', 'routed')"/>
                    <button name="action_ignore" type="object" string="Ignore"
                            invisible="state in ('routed', 'ignored')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,review,routed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="router_id"/>
                            <field name="source_type"/>
                            <field name="email_from" invisible="source_type != 'email'"/>
                            <field name="print_source" invisible="source_type != 'print'"/>
                        </group>
                        <group>
                            <field name="target_id" domain="[('router_id', '=', router_id)]"
                                   readonly="state in ('routed', 'ignored')"/>
                            <field name="confidence" widget="percentage"/>
                            <field name="exchange_record_id"/>
                            <field name="routed_record"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message"/>
                    </group>
                    <field name="probabilities" widget="json" invisible="not probabilities" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="edi_import_router_document_view_list" model="ir.ui.view">
        <field name="name">edi.import.router.document.list</field>
        <field name="model">edi.import.router.document</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="state == 'review'" decoration-muted="state == 'ignored'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="source_type"/>
                <field name="router_id"/>
                <field name="target_id"/>
                <field name="confidence" widget="percentage"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="edi_import_router_document_view_search" model="ir.ui.view">
        <field name="name">edi.import.router.document.search</field>
        <field name="model">edi.import.router.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email_from"/>
                <filter name="needs_review" string="Needs review" domain="[('state', 'in', ('review', 'error'))]"/>
                <filter name="routed" string="Routed" domain="[('state', '=', 'routed')]"/>
                <filter name="ignored" string="Ignored" domain="[('state', '=', 'ignored')]"/>
                <separator/>
                <filter name="email" string="Email" domain="[('source_type', '=', 'email')]"/>
                <filter name="print" string="Printer" domain="[('source_type', '=', 'print')]"/>
                <group expand="0">
                    <filter name="group_router" string="Router" context="{'group_by': 'router_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="edi_import_router_document_action" model="ir.actions.act_window">
        <field name="name">Routed Documents</field>
        <field name="res_model">edi.import.router.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_review': 1}</field>
    </record>
</odoo>
