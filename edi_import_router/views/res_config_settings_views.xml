<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_edi_import_router" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.edi.import.router</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="invite_users_setting" position="before">
                <setting
                    id="edi_import_router_typesafe"
                    help="API key used to route emailed and printed documents to an EDI exchange type"
                    groups="base.group_system"
                >
                    <field name="edi_import_router_typesafe_api_key" password="True"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
