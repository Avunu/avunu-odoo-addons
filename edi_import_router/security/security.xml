<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_import_router_reviewer" model="res.groups">
        <field name="name">Import router reviewer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <!-- The Odoo user ERP Printer signs in as: may upload a PDF to a router and
         nothing else. See models/ir_attachment.py. -->
    <record id="group_import_router_intake" model="res.groups">
        <field name="name">Import router: printer upload</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
</odoo>
