<odoo>
    <record model="ir.ui.view" id="mail_gateway_form_view">
        <field name="name">mail.gateway.form (twilio sms mirror)</field>
        <field name="model">mail.gateway</field>
        <field name="inherit_id" ref="mail_gateway_twilio.mail_gateway_form_view" />
        <field name="arch" type="xml">
            <field name="twilio_messaging_service_sid" position="after">
                <field
                    name="is_sms_mirror_target"
                    invisible="gateway_type != 'twilio'"
                />
            </field>
        </field>
    </record>
</odoo>
