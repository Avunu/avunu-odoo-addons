<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="base_import_pdf_template_line_view_form" model="ir.ui.view">
        <field name="name">base.import.pdf.template.line.form.create_missing</field>
        <field name="model">base.import.pdf.template.line</field>
        <field
            name="inherit_id"
            ref="base_import_pdf_by_template.base_import_pdf_template_line_view_form"
        />
        <field name="arch" type="xml">
            <field name="log_distinct_value" position="after">
                <field
                    name="create_missing"
                    invisible="value_type == 'fixed' or field_ttype != 'many2one' or not search_field_id"
                />
            </field>
            <notebook position="inside">
                <page
                    string="New Document Values"
                    name="page_create_value_ids"
                    invisible="not create_missing"
                >
                    <field name="create_value_ids" context="{'default_line_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="field_id" options="{'no_create': True}" />
                            <field name="field_ttype" column_invisible="1" />
                            <field name="field_relation" column_invisible="1" />
                            <field name="value_type" />
                            <field
                                name="fixed_value"
                                string="Value"
                                invisible="value_type != 'fixed' or field_ttype in ('many2one', 'reference')"
                            />
                            <field
                                name="fixed_value_ref"
                                string="Value"
                                invisible="value_type != 'fixed' or field_ttype not in ('many2one', 'reference')"
                            />
                            <field
                                name="pattern"
                                string="Pattern"
                                invisible="value_type == 'fixed'"
                            />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
