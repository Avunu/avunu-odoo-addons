<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Compact list: opens `..._view_form` below on a row click (same
         list+form pattern base_import_pdf_by_template itself uses for
         `base.import.pdf.template.line_ids` - see
         `base_import_pdf_template_view_form`'s `line_ids` field). Needed
         because this row's fields are heavily mutually-exclusive
         (Value/Value-as-record/Pattern/JSONPath) - an editable inline
         list has no way to truly hide a column per row, only per row
         VALUE, so every one of those columns would show, always, with
         its own "Value"-labeled header regardless of which row is
         selected. A form's `invisible` genuinely removes the field
         (and its label) from a given row's dialog instead. -->
    <record id="base_import_pdf_template_line_create_value_view_tree" model="ir.ui.view">
        <field name="name">base.import.pdf.template.line.create.value.list</field>
        <field name="model">base.import.pdf.template.line.create.value</field>
        <field name="arch" type="xml">
            <!-- A row that still needs something is highlighted rather
                 than blocked: the user is free to fill the table in any
                 order, and over several sittings. -->
            <list decoration-warning="has_missing_required">
                <field name="sequence" widget="handle" />
                <field name="field_id" />
                <field name="is_required" widget="boolean" optional="show" />
                <field name="value_type" />
                <field name="value_summary" />
                <field name="has_missing_required" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="base_import_pdf_template_line_create_value_view_form" model="ir.ui.view">
        <field name="name">base.import.pdf.template.line.create.value.form</field>
        <field name="model">base.import.pdf.template.line.create.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not has_missing_required"
                    >
                        This field is required by the document being created and
                        has no value yet. You can still save and come back to it -
                        the document simply will not be created until it is filled
                        in.
                    </div>
                    <group>
                        <field name="line_id" invisible="1" />
                        <field name="candidate_model_ids" invisible="1" />
                        <field name="has_missing_required" invisible="1" />
                        <field name="fixed_value_kind" invisible="1" />
                        <field
                            name="field_id"
                            options="{'no_create': True}"
                        />
                        <field name="field_ttype" invisible="1" />
                        <field name="field_relation" invisible="1" />
                        <field name="is_required" invisible="not field_id" />
                        <field
                            name="value_type"
                            widget="radio"
                            options="{'horizontal': True}"
                            invisible="not field_id or field_ttype == 'one2many'"
                        />
                        <!-- Typed Fixed value: exactly one of these shows,
                             picked by `fixed_value_kind` - the same mapping
                             `_fixed_create_value()` reads, so the input and
                             the value that ends up in the document can never
                             drift apart. -->
                        <field
                            name="fixed_value"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'char'"
                        />
                        <field
                            name="fixed_value_boolean"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'boolean'"
                        />
                        <field
                            name="fixed_value_integer"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'integer'"
                        />
                        <field
                            name="fixed_value_float"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'float'"
                        />
                        <field
                            name="fixed_value_selection_id"
                            options="{'no_create': True, 'no_open': True}"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'selection'"
                        />
                        <field
                            name="fixed_value_date"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'date'"
                        />
                        <field
                            name="fixed_value_datetime"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'datetime'"
                        />
                        <field
                            name="fixed_value_ref"
                            invisible="value_type != 'fixed' or fixed_value_kind != 'record'"
                        />
                        <field
                            name="pattern"
                            invisible="not field_id or field_ttype == 'one2many' or value_type != 'variable'"
                        />
                    </group>
                    <div
                        class="text-muted"
                        invisible="value_type != 'odoo_default'"
                    >
                        This field is left out of the new document entirely, so
                        Odoo applies its own default when the document is created.
                    </div>
                    <notebook invisible="field_ttype != 'one2many'">
                        <page string="Row Values" name="page_child_value_ids">
                            <field
                                name="child_value_ids"
                                nolabel="1"
                                context="{
                                    'list_view_ref': 'import_create_missing.base_import_pdf_template_line_create_value_view_tree',
                                    'form_view_ref': 'import_create_missing.base_import_pdf_template_line_create_value_view_form',
                                    'default_line_id': line_id,
                                    'default_parent_id': id,
                                }"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
