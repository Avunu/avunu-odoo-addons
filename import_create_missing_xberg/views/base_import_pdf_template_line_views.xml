            name="name"
        >base.import.pdf.template.line.create.value.form.create_missing_xberg</field>
        <field name="model">base.import.pdf.template.line.create.value</field>
        <field
            name="inherit_id"
            ref="import_create_missing.base_import_pdf_template_line_create_value_view_form"
        />
        <field name="arch" type="xml">
            <field name="pattern" position="after">
                <field
                    name="xberg_jsonpath"
                    invisible="not field_id or field_ttype == 'one2many' or value_type == 'fixed'"
                    placeholder="$.tables[1].cellsByHeader[*]['Description']"
                />
            </field>
        </field>
    </record>
</odoo>
